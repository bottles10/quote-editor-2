<%= form_with(model: [quote, line_item_date]) do |form| %>
    <%= error_messages_for(line_item_date) %>

    <div class="flex items-center justify-between">
        <div class="grow">
            <%= form.label :date, class: "font-medium" %>
            <%= form.date_field :date, class: "form-control border-r-0 border-purple-200 rounded-r-none caret-purple-800" %>
        </div>

        <div class="self-end-safe">
            <%= form.submit line_item_date.new_record? ? "Create date" : "Update date", class: "btn btn-primary rounded-l-none" %>
        </div>
    </div>
<% end %>