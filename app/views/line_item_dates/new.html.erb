<div class="mb-12">
    <%= link_to sanitize("&larr; Back to quote"), quote_path(@quote), class: "inline-block mb-4 text-gray-400" %>
    <h1 class="header">New date</h1>
</div>

<div class="mb-12 p-3 border border-gray-300 rounded space-y-4">
    <%= render partial: "form", locals: { quote: @quote, line_item_date: @line_item_date } %>
    <%= link_to sanitize("&times; Cancel"), quote_path(@quote), class: "btn actions" %>
</div>