<%= turbo_frame_tag line_item_date do %>
    <div class="mb-4 p-3 flex items-center justify-between border border-gray-300 rounded">
        <h2><%= l(line_item_date.date, format: :long) %></h2>
        <div class="flex items-center gap-3">
            <%= link_to "Edit", [ :edit, quote, line_item_date ], class: "btn actions" %>
            <%= button_to "Delete", 
                                [ quote, line_item_date ],
                                method: :delete,
                                data: { turbo_confirm: "Are you sure?" },
                                class: "btn actions" 
            %>
        </div>
    </div>
<% end %>