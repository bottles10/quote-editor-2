<div>
    <h1 class="header text-4xl">Quote editor</h1>
    <p>A blazing fast quote editor built with Hotwire</p>

    <div class="mt-8">
        <% if user_signed_in? %>
            <%= link_to "View quotes", quotes_path, class: "btn btn-primary" %>
        <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "btn btn-primary" %>
        <% end %>
    </div>
</div>