<div class="mb-8">
    <%= link_to sanitize("&larr; Back to quotes"), quotes_path, class: "inline-block mb-4 text-gray-400" %>
</div>

<div class="mb-4 flex items-center justify-between">
    <h1 class="header"><%= @quote.name %></h1>
    <%= link_to "New date", 
                        new_quote_line_item_date_path(@quote), 
                        data: { turbo_frame: dom_id(LineItemDate.new) },
                        class: "btn btn-primary" 
    %>
</div>

<hr class="muted mb-12 ">

<%= turbo_frame_tag LineItemDate.new %>

<%= turbo_frame_tag "line_item_dates" do %>
    <%= render @line_item_dates, quote: @quote %>
<% end %>

<%= turbo_frame_tag dom_id(@quote, :total) do %>
    <%= render partial: "total", locals: { quote: @quote } %>
<% end %>