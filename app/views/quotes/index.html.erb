<%= turbo_stream_from current_company, "quotes" %>

<div class="mb-4 flex items-center justify-between">
    <h1 class="font-bold text-4xl">Quotes</h1>
    <%= link_to 'New Quote', new_quote_path,
                            data: { turbo_frame: dom_id(Quote.new) },
                            class: "btn btn-primary" 
    %>
</div>

<hr class="muted mb-12">

<%= turbo_frame_tag Quote.new do %>
    <% if @quotes.none? %>
        <%= render partial: "empty_state" %>
    <% end %>
<% end %>

<div id="quotes" class="flex flex-col gap-3">
    <%= render @quotes %>
</div>