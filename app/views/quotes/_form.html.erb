<%= form_with(model: quote) do |form| %>
    <%= error_messages_for(quote) %>
    
    <div class="flex items-center">
        <div class="grow">
            <%= form.label :name, class: "font-medium text-gray-700" %>
            <%= form.text_field :name, autofocus: true, placeholder: " Add a quote...", class: "form-control border-r-0 border-purple-200 rounded-r-none caret-purple-800" %>
        </div>

        <div class="self-end-safe">
            <%= form.submit class: "btn btn-primary rounded-l-none" %>
        </div>
    </div>
<% end %>