<div class="mb-12">
    <%= link_to sanitize("&larr; Back to quotes"), quotes_path, class: "inline-block mb-4 text-gray-400" %>
    <h1 class="header">New quote</h1>
</div>

<%= turbo_frame_tag @quote do %>
    <div class="mb-12 p-3 border border-gray-300 rounded space-y-4">
        <%= render partial: "form", locals: { quote: @quote } %>
        <%= link_to sanitize("&times; Cancel"), quotes_path, class: "btn actions" %>
    </div>
<% end %>