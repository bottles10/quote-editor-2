<header class="p-3 flex items-center justify-between border-b border-gray-300 shadow">
    <% if user_signed_in? %>
        <div class="font-bold text-xl">
            <%= current_company.name%>
        </div>
        <div class="flex items-center gap-3">
            <p class="font-bold"><%= current_user.name %></p>
            <%= button_to "Sign out", destroy_user_session_path, 
                                method: :delete, 
                                data: { turbo_confirm: "Are you sure?" },
                                class: "btn btn-primary"
            %>
        </div>
    <% else %>
        <%= link_to "Sign in", new_user_session_path, class: "btn btn-primary ml-auto" %>
    <% end %>
</header>